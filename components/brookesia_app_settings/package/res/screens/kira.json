{
    "type": "viewScreen",
    "id": "kira",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "label",
                    "id": "status",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Kira OS settings"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                }
            ]
        }
    ]
}
