{
    "type": "viewScreen",
    "id": "kira",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "label",
                    "id": "notice",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": ""
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
                {
                    "type": "label",
                    "id": "assistant_section",
                    "styleRefs": [
                        "app.listItemTitle"
                    ],
                    "labelProps": {
                        "text": "Assistant"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    }
                },
                {
                    "type": "templateRef",
                    "id": "open",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.open"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Open Kira"
                            }
                        }
                    }
                },
                {
                    "type": "templateRef",
                    "id": "autostart",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.autostart"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Start Kira after inactivity"
                            }
                        }
                    }
                },
                {
                    "type": "templateRef",
                    "id": "idle",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.idle"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Inactivity timeout"
                            }
                        }
                    }
                },
                {
                    "type": "label",
                    "id": "ai_section",
                    "styleRefs": [
                        "app.listItemTitle"
                    ],
                    "labelProps": {
                        "text": "Voice and AI"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    }
                },
                {
                    "type": "templateRef",
                    "id": "provider",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.provider"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Voice provider: OpenAI"
                            }
                        }
                    }
                },
                {
                    "type": "templateRef",
                    "id": "model",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.model"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Realtime model"
                            }
                        }
                    }
                },
                {
                    "type": "templateRef",
                    "id": "key",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.key"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "API key: not set"
                            }
                        }
                    }
                },
                {
                    "type": "label",
                    "id": "update_section",
                    "styleRefs": [
                        "app.listItemTitle"
                    ],
                    "labelProps": {
                        "text": "Version / update"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    }
                },
                {
                    "type": "label",
                    "id": "version",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Current version"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
                {
                    "type": "label",
                    "id": "update_status",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Updates have not been checked."
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
                {
                    "type": "templateRef",
                    "id": "update_check",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.update_check"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Check for updates"
                            }
                        }
                    }
                },
                {
                    "type": "templateRef",
                    "id": "update_install",
                    "templateId": "setting_row",
                    "overrides": {
                        ".": {
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.kira.update_install"
                                }
                            ]
                        },
                        "title": {
                            "labelProps": {
                                "text": "Install verified update"
                            }
                        }
                    }
                }
            ]
        }
    ]
}
